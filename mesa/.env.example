PORT=3000

# Conversión fija para la demo. No representa una cotización de mercado.
DEMO_ARS_PER_USDT=1000

# Política WDK SDK: máximo 25 USDt (6 decimales) por pago demo.
WDK_DEMO_MAX_USDT_BASE_UNITS=25000000

# Dirección usada solamente por el flujo simulado legado.
WDK_DEMO_MERCHANT_ADDRESS=0x1111111111111111111111111111111111111111

# WDK CLI Track 1: nombres de wallets locales y dedicadas a Sepolia.
# Las seed phrases y passphrases NO van en este archivo.
WDK_CLIENT_WALLET=mesa-cliente-demo
WDK_BUSINESS_WALLET=mesa-negocio-demo
WDK_CLI_TOKEN=usdt

# Opcional: ruta/nombre del ejecutable si 'wdk' no está en PATH.
# WDK_CLI_BIN=wdk

# Chatbot opcional con QVAC local (OpenAI-compatible).
# Por seguridad la app sólo acepta localhost/127.0.0.1/::1.
QVAC_BASE_URL=http://127.0.0.1:11434/v1/
# QVAC_MODEL=my-llm

# ── IA local (QVAC) · @qvac/sdk@0.17.1 ──────────────────────────────────────
# El modelo lo carga ESTA app, en su propio proceso: no hay servidor que
# levantar aparte ni clave de API en ningun lado. Lo unico que toca la red es
# la descarga del modelo, una sola vez, a ~/.qvac/models.
#
#   QVAC_MODE=sdk       (por defecto) inferencia in-process con @qvac/sdk.
#   QVAC_MODE=http      el adaptador contra `qvac serve openai` (QVAC_BASE_URL).
#   QVAC_MODE=apagado   sin IA: el asistente usa el motor determinista y la
#                       pantalla lo aclara con una etiqueta distinta.
QVAC_MODE=sdk

# Nombre de la constante del registro de QVAC, tal cual la exporta el SDK.
#   QWEN3_4B_INST_Q4_K_M     2,50 GB · ~11 s por consulta · 100% en confiabilidad
#   LLAMA_3_2_1B_INST_Q4_0   0,77 GB · ~3,4 s · 92-93% en repetir y copiar
# Los numeros salen de scripts/confiabilidad-qvac.mjs en la maquina del README.
QVAC_MODELO_SDK=QWEN3_4B_INST_Q4_K_M
QVAC_DEVICE=cpu
QVAC_CTX=4096

# ── El agente de caja (WDK Track 1) ─────────────────────────────────────────
# El modelo local opera la billetera por WDK CLI bajo estas barandas. Son
# "user-defined guardrails": si las cambias aca, cambian de verdad, porque se
# evaluan en codigo y ademas arman el enum de la gramatica que restringe al
# modelo.
#
# El agente NUNCA transmite: `wdk send` no esta entre sus acciones. Llega hasta
# `wdk send --dry-run` y la confirmacion la da una persona.
AGENTE_TOPE_OPERACION=25
AGENTE_TOPE_DIARIO=100
# Nombres, no direcciones. El modelo elige de esta lista y no puede escribir
# una direccion arbitraria: no hay token para eso en la gramatica.
AGENTE_DESTINATARIOS=caja
AGENTE_MAX_PASOS=5

# ── WDK CLI simulado (solo para demostrar sin fondear Sepolia) ──────────────
# Enchufa un CLI de mentira en lugar del binario `wdk`. NO es el valor por
# defecto: sin esta variable corre el CLI de verdad.
#
# Cuando esta activo lo grita la terminal al arrancar, lo devuelve
# GET /api/config y la pantalla del checkout muestra un cartel ambar. Un pago
# simulado que se hace pasar por real es lo que un jurado tiene que poder
# descartar de un vistazo.
#
# Para el cobro on-chain de verdad: sacar esta variable y desbloquear las
# wallets con `wdk wallet unlock`.
# WDK_CLI_MODE=simulado
WDK_SALDO_CLIENTE=100
WDK_SALDO_NEGOCIO=0
