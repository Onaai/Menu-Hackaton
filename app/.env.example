# Mesa Abierta — variables opcionales. La app arranca sin ninguna de estas.

# Puerto y URL base (la URL base se usa para el redirect de OAuth).
PORT=3000
BASE_URL=http://localhost:3000

# ── IA local (QVAC) ─────────────────────────────────────────────────────────
# Servidor compatible con OpenAI que levantás aparte con:
#     qvac serve openai --preload <modelo>
# Si no responde, las sugerencias salen del plan B y la pantalla lo dice.
QVAC_URL=http://localhost:11434
QVAC_MODEL=qwen3-4b-instruct-q4

# ── Pagos ───────────────────────────────────────────────────────────────────
# Hoy son SIMULADOS: no hay blockchain, ni claves, ni frase semilla.
# Estos dos valores solo se muestran en pantalla y en el log de la terminal.
# Cuando se pase al adaptador real de WDK, tienen que ser la red y el token
# donde de verdad esté la plata.
WDK_NETWORK=sepolia
WDK_TOKEN=USDT

# ── Inicio de sesión con Google ─────────────────────────────────────────────
# Si NO están, el registro corre en modo demo y la pantalla lo aclara.
# Si están, se usa el flujo OAuth real. El redirect a autorizar en la consola
# de Google es:  http://localhost:3000/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Apple no tiene variables: "Sign in with Apple" exige una cuenta de Apple
# Developer paga, así que ese botón corre siempre en modo demo.
